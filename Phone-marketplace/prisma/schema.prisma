// ============================================================
// EUT Marketplace - Database Schema
// ============================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  BUYER
  SELLER
  ADMIN
}

enum SellerRank {
  NEW
  TRUSTED
  TOP_SELLER
}

enum SellerStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

enum ProductStatus {
  PENDING
  ACTIVE
  SOLD
  HIDDEN
  REJECTED
}

enum ProductCondition {
  LIKE_NEW    // Như mới (99-100%)
  PERFECT_99  // 99% - Mới chưa sử dụng
  EXCELLENT_98 // 98% - Như mới
  EXCELLENT_97 // 97% - Rất đẹp
  GOOD         // < 97% - Đẹp thường dùng
}

enum WarrantyType {
  WITH_WARRANTY      // Còn bảo hành
  OUT_OF_WARRANTY    // Hết bảo hành
  SELLER_WARRANTY    // Bảo hành từ người bán
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  CONFIRMED
  SHIPPING
  DELIVERED
  RECEIVED        // Buyer đã nhận và kiểm tra hàng, bắt đầu return period
  RETURN_PERIOD     // Đang trong thời gian dùng thử (14 ngày)
  RETURN_PENDING   // Buyer yêu cầu trả hàng, chờ Seller duyệt
  RETURN_APPROVED  // Seller đồng ý, chờ Admin duyệt hoàn tiền
  RETURN_REJECTED  // Seller từ chối yêu cầu trả hàng
  FRAUD_BUYER      // Gian lận phía Buyer (tráo hàng)
  FRAUD_SELLER     // Gian lận phía Seller (giao không đúng)
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  SEPAY
  COD
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum ReturnRequestStatus {
  PENDING        // Chờ Seller duyệt
  SELLER_APPROVED // Seller đồng ý, chờ Admin duyệt
  SELLER_REJECTED  // Seller từ chối
  ADMIN_APPROVED   // Admin duyệt hoàn tiền → REFUNDED
  ADMIN_REJECTED    // Admin từ chối hoàn tiền
  CANCELLED        // Buyer hủy yêu cầu
}

enum ReturnReason {
  WRONG_ITEM           // Giao sai sản phẩm
  DAMAGED              // Sản phẩm bị hư hỏng
  NOT_AS_DESCRIBED    // Không đúng như mô tả
  FAKE_PRODUCT        // Sản phẩm giả/hàng nhái
  CHANGED_MIND        // Đổi ý (không bắt buộc chấp nhận)
  OTHER               // Lý do khác
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  COUNTERED
  EXPIRED
  CANCELLED
}

enum NegotiationType {
  OFFER
  COUNTER_OFFER
}

enum MessageType {
  TEXT
  IMAGE
  SYSTEM
}

enum NotificationType {
  ORDER_CREATED
  ORDER_UPDATED
  ORDER_PAID
  ORDER_DELIVERED
  ORDER_RETURN_PERIOD_STARTED  // Bắt đầu 14 ngày dùng thử
  ORDER_RETURN_PERIOD_REMINDER // Nhắc nhở sắp hết hạn return
  ORDER_RETURN_REQUESTED       // Buyer yêu cầu trả hàng
  ORDER_RETURN_APPROVED_BY_SELLER // Seller đồng ý trả hàng
  ORDER_RETURN_REJECTED_BY_SELLER // Seller từ chối trả hàng
  ORDER_REFUND_APPROVED        // Admin duyệt hoàn tiền
  ORDER_REFUND_REJECTED        // Admin từ chối hoàn tiền
  ORDER_FRAUD_DETECTED        // Phát hiện gian lận
  OFFER_RECEIVED
  OFFER_RESPONSE
  MESSAGE_NEW
  PRODUCT_APPROVED
  PRODUCT_REJECTED
  SELLER_APPROVED
  SELLER_REJECTED
  TRUST_SCORE_UPDATED
  REVIEW_RECEIVED
}

enum HealthCheckStatus {
  PASS
  FAIL
  NOT_TESTED
}

// ============================================================
// OAUTH ACCOUNTS & EMAIL VERIFICATION & PASSWORD RESET
// ============================================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at       Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime

  @@index([email])
}

// ============================================================
// USER & AUTH
// ============================================================

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  password        String?
  name            String
  phone           String?
  avatar          String?
  role            UserRole  @default(BUYER)
  isVerified      Boolean   @default(false)
  isLocked        Boolean   @default(false)
  lockedAt        DateTime?  // Thời gian bị khóa
  lockedReason    String?    // Lý do khóa
  lockedBy        String?    // Admin đã khóa
  emailVerifiedAt DateTime?

  sellerStatus    SellerStatus @default(NONE)
  sellerRequestAt DateTime?
  sellerApprovedAt DateTime?
  sellerRejectedReason String?

  sellerRank      SellerRank @default(NEW)
  sellerStats     SellerStats?

  addresses       Address[]
  products        Product[]
  ordersAsBuyer   Order[]   @relation("BuyerOrders")
  ordersAsSeller  Order[]   @relation("SellerOrders")
  offers          Offer[]
  reviewsGiven    Review[]  @relation("ReviewsGiven")
  reviewsReceived Review[]  @relation("ReviewsReceived")
  messages        Message[]
  notifications   Notification[]
  conversations   ConversationParticipant[]
  trustScoreHistory TrustScoreHistory[]
  wishlistItems   Wishlist[]
  aiConversations AIConversation[]
  productViews    ProductView[]

  // OAuth accounts
  accounts        Account[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([email])
  @@index([role])
  @@index([sellerStatus])
}

model SellerStats {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  totalTransactions   Int      @default(0)
  successfulDeals     Int      @default(0)
  cancelledDeals      Int      @default(0)
  totalRevenue        Decimal  @default(0) @db.Decimal(15, 2)
  avgResponseTimeMin  Int?
  
  avgRating           Decimal  @default(0) @db.Decimal(3, 2)
  totalReviews        Int      @default(0)
  successRate         Decimal  @default(0) @db.Decimal(5, 2)
  
  isIdentityVerified  Boolean  @default(false)
  identityVerifiedAt DateTime?
  
  updatedAt           DateTime @updatedAt
}

model Address {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName    String
  phone       String
  street      String

  // Cau truc dia chi moi (sau 07/2025 - bo qua cap quan/huyen)
  provinceCode String  // Ma tinh (VD: "01")
  provinceName String  // Ten tinh (VD: "Thanh pho Ha Noi")
  wardCode     String  // Ma phuong/xa (VD: "00070")
  wardName     String  // Ten phuong/xa (VD: "Phuong Hoan Kiem")

  // Cau truc cu (de hien thi dia chi day du + chuyen doi neu can)
  district    String   @default("")
  city        String   @default("")

  // Cac truong du phong cho tich hop voi he thong cu
  // Khi nhap dia chi cu, co the lay district/city tu truong ward

  isDefault   Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model TrustScoreHistory {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  score       Decimal     @db.Decimal(3, 2)
  rank        SellerRank
  reason      String

  createdAt   DateTime    @default(now())

  @@index([userId])
}

model Wishlist {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
}

// ============================================================
// BRAND & CATEGORY
// ============================================================

model Brand {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  logo        String?
  isActive    Boolean  @default(true)
  
  models      PhoneModel[]
  products    Product[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PhoneModel {
  id          String   @id @default(cuid())
  brandId     String
  brand       Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  
  name        String
  slug        String   @unique
  releaseYear Int?
  
  defaultRam      Int[]
  defaultStorage  Int[]
  basePrice       Decimal? @db.Decimal(15, 2)
  
  products    Product[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([brandId])
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  icon        String?
  parentId    String?
  parent      Category? @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  
  products    Product[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([parentId])
}

// ============================================================
// PRODUCT
// ============================================================

model Product {
  id              String          @id @default(cuid())
  sellerId        String
  seller          User            @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  
  brandId         String
  brand           Brand           @relation(fields: [brandId], references: [id])
  
  modelId         String
  model           PhoneModel      @relation(fields: [modelId], references: [id])
  
  categoryId      String
  category        Category        @relation(fields: [categoryId], references: [id])
  
  title           String
  slug            String          @unique
  description     String?
  
  condition       ProductCondition
  warranty        WarrantyType     @default(OUT_OF_WARRANTY)
  ramGb           Int
  storageGb       Int
  color           String
  imei            String?
  batteryHealth   Int
  stock          Int?            // Số lượng trong kho, null = không giới hạn
  
  price           Decimal         @db.Decimal(15, 2)
  negotiable      Boolean         @default(true)
  
  status          ProductStatus   @default(PENDING)
  rejectionReason String?
  
  images          ProductImage[]
  healthCheck     HealthCheck?
  
  viewCount       Int             @default(0)
  
cartItems       CartItem[]
  orderItems      OrderItem[]
  offers          Offer[]
  reviews         Review[]
  conversations   Conversation[]
  wishlistItems   Wishlist[]
  views           ProductView[]

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  
  @@index([sellerId])
  @@index([brandId])
  @@index([modelId])
  @@index([status])
  @@index([price])
  @@index([condition])
  @@index([createdAt(sort: Desc)])
}

model ProductImage {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  url         String
  publicId    String?
  isPrimary   Boolean  @default(false)
  sortOrder   Int      @default(0)
  
  createdAt   DateTime @default(now())
  
  @@index([productId])
}

model HealthCheck {
  id                  String   @id @default(cuid())
  productId           String   @unique
  product             Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  // === Device Info ===
  serialNumber        String?
  wifiMacAddress      String?
  bluetoothMacAddress String?

  // === OS Version ===
  iosVersion          String?
  androidVersion      String?

  // === Software Check ===
  activationStatus    String?  // Trạng thái kích hoạt (Active/Inactive)
  jailbreakStatus     String?  // Trạng thái JB (iPhone) / Root (Android)
  securityLockStatus  String?  // iCloud Lock (iPhone) / FRP (Android)

  // === Battery ===
  batteryHealth       Int
  batteryCycleCount   Int?

  // === Components ===
  screen              HealthCheckStatus @default(NOT_TESTED)
  cameraFront         HealthCheckStatus @default(NOT_TESTED)
  cameraBack          HealthCheckStatus @default(NOT_TESTED)
  speaker             HealthCheckStatus @default(NOT_TESTED)
  microphone          HealthCheckStatus @default(NOT_TESTED)
  wifi                HealthCheckStatus @default(NOT_TESTED)
  bluetooth           HealthCheckStatus @default(NOT_TESTED)
  fingerprint         HealthCheckStatus @default(NOT_TESTED)
  faceId              HealthCheckStatus @default(NOT_TESTED)
  chargingPort        HealthCheckStatus @default(NOT_TESTED)

  // === Summary ===
  overallStatus       String?
  notes               String?

  createdAt           DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// ============================================================
// PRODUCT ANALYTICS (view tracking)
// ============================================================

model ProductView {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  ipAddress   String?
  userAgent   String?  @db.Text
  referer     String?  @db.Text

  createdAt   DateTime @default(now())

  @@index([productId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([userId])
  @@index([ipAddress, createdAt])
}

// ============================================================
// NEGOTIATION & OFFERS
// ============================================================

model Offer {
  id              String          @id @default(cuid())
  productId       String
  product         Product         @relation(fields: [productId], references: [id], onDelete: Cascade)

  buyerId         String
  buyer           User            @relation(fields: [buyerId], references: [id])

  offeredPrice    Decimal         @db.Decimal(15, 2)
  finalPrice      Decimal?        @db.Decimal(15, 2)  // Giá deal cuối cùng khi chốt
  message         String?
  type            NegotiationType @default(OFFER)

  status          OfferStatus     @default(PENDING)
  responseMessage String?
  respondedAt     DateTime?

  parentOfferId   String?
  parentOffer     Offer?          @relation("OfferChain", fields: [parentOfferId], references: [id])
  counterOffers   Offer[]         @relation("OfferChain")

  // Cart items that used this offer
  cartItems       CartItem[]

  expiresAt       DateTime

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([productId])
  @@index([buyerId])
  @@index([status])
  @@index([expiresAt])
}

// ============================================================
// CART & ORDERS
// ============================================================

model Cart {
  id          String     @id @default(cuid())
  userId      String     @unique
  items       CartItem[]
  
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model CartItem {
  id          String   @id @default(cuid())
  cartId      String
  cart        Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)

  productId   String
  product     Product  @relation(fields: [productId], references: [id])

  quantity    Int      @default(1)
  price       Decimal? @db.Decimal(15, 2)  // Giá đã deal (nếu có)
  offerId     String?                   // Offer đã chốt deal
  offer       Offer?   @relation(fields: [offerId], references: [id])
  addedAt     DateTime @default(now())

  @@unique([cartId, productId])
  @@index([cartId])
}

model Order {
  id              String      @id @default(cuid())
  orderCode       String      @unique
  
  buyerId         String
  buyer           User        @relation("BuyerOrders", fields: [buyerId], references: [id])
  
  sellerId        String
  seller          User        @relation("SellerOrders", fields: [sellerId], references: [id])
  
  shippingAddress String
  
  items           OrderItem[]
  
  subtotal        Decimal     @db.Decimal(15, 2)
  shippingFee     Decimal     @default(0) @db.Decimal(15, 2)
  totalAmount     Decimal     @db.Decimal(15, 2)
  
  status          OrderStatus @default(PENDING_PAYMENT)
  
  paymentMethod   PaymentMethod?
  paymentStatus   PaymentStatus @default(PENDING)
  paymentId       String?
  paidAt          DateTime?
  paymentDeadline DateTime?    // Thời hạn thanh toán (mặc định 30 phút)
  
  buyerConfirmed      Boolean     @default(false)
  buyerConfirmedAt   DateTime?
  
  confirmedAt     DateTime?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?
  cancelReason    String?
  
  refundedAt      DateTime?
  refundReason    String?

  // === RETURN PERIOD TRACKING ===
  returnPeriodStartedAt DateTime?  // Thời điểm bắt đầu RETURN_PERIOD (sau DELIVERED)
  returnPeriodEndsAt    DateTime?  // Thời điểm kết thúc (returnPeriodStartedAt + 14 ngày)

  // === RETURN REQUEST ===
  returnRequest    ReturnRequest?

  notes           String?
  
  reviews         Review[]
  payment         PaymentTransaction?
  
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  
  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  
  title       String
  price       Decimal  @db.Decimal(15, 2)
  image       String
  
  quantity    Int      @default(1)
  
  offerId     String?
  
  createdAt   DateTime @default(now())
  
  @@index([orderId])
}

// ============================================================
// PAYMENT
// ============================================================

model PaymentTransaction {
  id              String        @id @default(cuid())
  orderId         String        @unique
  order           Order         @relation(fields: [orderId], references: [id])
  
  amount          Decimal       @db.Decimal(15, 2)
  method          PaymentMethod
  
  sepayTransactionId String?
  sepayStatus        String?
  
  status          PaymentStatus @default(PENDING)
  
  requestData     Json?
  responseData    Json?
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  @@index([orderId])
}

// ============================================================
// RETURN REQUEST
// ============================================================

model ReturnRequest {
  id              String              @id @default(cuid())
  orderId         String              @unique
  order           Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // === Người yêu cầu ===
  requestedById   String              // Buyer ID

  // === Lý do trả hàng ===
  reason          ReturnReason
  description     String?            // Mô tả chi tiết thêm
  images          String[]           // Hình ảnh bằng chứng

  // === Trạng thái ===
  status          ReturnRequestStatus @default(PENDING)

  // === Seller response ===
  sellerId        String?             // Seller duyệt
  sellerDecision String?             // APPROVED / REJECTED
  sellerReason    String?            // Lý do từ chối (nếu có)
  sellerDecidedAt DateTime?

  // === Admin response ===
  adminId         String?
  adminDecision   String?            // APPROVED / REJECTED / FRAUD_BUYER / FRAUD_SELLER
  adminReason     String?
  adminDecidedAt  DateTime?

  // === Admin review (kiểm tra gian lận) ===
  adminReviewNotes String?           // Ghi chú admin khi xác minh
  fraudEvidence    Json?             // Bằng chứng gian lận (nếu phát hiện)

  // === Refund tracking ===
  refundAmount    Decimal?           @db.Decimal(15, 2)
  refundedAt      DateTime?

  // === Tracking ===
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([orderId])
  @@index([status])
  @@index([requestedById])
}

// ============================================================
// CHAT & MESSAGES
// ============================================================

model Conversation {
  id          String      @id @default(cuid())

  participants ConversationParticipant[]

  productId   String?
  product     Product?    @relation(fields: [productId], references: [id])

  lastMessageAt DateTime?

  unreadCounts Json?

  messages    Message[]

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?   // Soft delete toàn cuộc trò chuyện (khi cả 2 người đều rời)

  @@index([lastMessageAt(sort: Desc)])
  @@index([productId])
}

model ConversationParticipant {
  id              String       @id @default(cuid())
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  joinedAt        DateTime     @default(now())
  leftAt          DateTime?    // Soft delete - người dùng đã rời khỏi cuộc trò chuyện

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id              String       @id @default(cuid())
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  
  senderId        String
  sender          User         @relation(fields: [senderId], references: [id])
  
  type            MessageType  @default(TEXT)
  content         String
  
  mediaUrl        String?
  mediaType       String?
  
  readAt          DateTime?
  
  createdAt       DateTime     @default(now())
  
  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt(sort: Desc)])
}

// ============================================================
// REVIEWS & RATINGS
// ============================================================

model Review {
  id          String       @id @default(cuid())
  
  orderId     String       @unique
  order       Order        @relation(fields: [orderId], references: [id])
  
  productId   String
  product     Product      @relation(fields: [productId], references: [id])
  
  reviewerId  String
  reviewer    User         @relation("ReviewsGiven", fields: [reviewerId], references: [id])
  
  revieweeId  String
  reviewee    User         @relation("ReviewsReceived", fields: [revieweeId], references: [id])
  
  rating      Int
  
  accuracy      Int?
  communication Int?
  delivery      Int?
  
  comment     String?
  photos      String[]
  
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  
  @@index([productId])
  @@index([revieweeId])
  @@index([createdAt(sort: Desc)])
}

// ============================================================
// NOTIFICATIONS
// ============================================================

model Notification {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  type        NotificationType
  title       String
  message     String
  
  relatedId   String?
  relatedType String?
  
  isRead      Boolean          @default(false)
  readAt      DateTime?
  
  data        Json?
  
  createdAt   DateTime         @default(now())
  
  @@index([userId, isRead])
  @@index([userId, createdAt(sort: Desc)])
}

// ============================================================
// SYSTEM & SETTINGS
// ============================================================

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  description String?
  
  updatedAt   DateTime @updatedAt
}

// ============================================================
// PRICE HISTORY
// ============================================================

// ============================================================
// AI SHOPPING ASSISTANT
// ============================================================

enum AIIntent {
  PRODUCT_SEARCH
  PRODUCT_COMPARISON
  PRODUCT_QUESTION
  ORDER_SUPPORT
  PAYMENT_SUPPORT
  RETURN_REFUND
  POLICY_FAQ
  SHOPPING_PREFERENCE
  OUT_OF_SCOPE
}

model AIConversation {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  messages    AIMessage[]

  // Conversation state for slot filling
  state       Json?       // { "intent": "PRODUCT_SEARCH", "budget": 10000000, "brand": "Xiaomi", "usage": "gaming", "stage": "collecting" }

  // Analytics
  intentCounts Json?      // { "PRODUCT_SEARCH": 5, "ORDER_SUPPORT": 2 }

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([userId])
  @@index([createdAt(sort: Desc)])
}

model AIMessage {
  id              String        @id @default(cuid())
  conversationId  String
  conversation    AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role            String        // "user" | "assistant" | "system"
  content         String        @db.Text
  htmlContent    String?      @db.Text  // Rendered HTML version with product links

  intent          AIIntent?     // Detected intent
  metadata        Json?         // Additional data (search results, etc.)

  tokensUsed      Int?          // Token count for cost tracking

  createdAt       DateTime      @default(now())

  @@index([conversationId])
  @@index([createdAt(sort: Desc)])
}

model PriceHistory {
  id          String   @id @default(cuid())
  
  brandId     String
  modelId     String
  condition   ProductCondition
  storageGb  Int
  
  price       Decimal  @db.Decimal(15, 2)
  
  productId   String?
  
  createdAt   DateTime @default(now())
  
  @@index([modelId, condition, storageGb])
  @@index([createdAt])
}
